<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/chiron"
        android:adjustViewBounds="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="horizontal"
        >

        <Button
            android:id="@+id/buttonWstecz"
            android:layout_width="138dp"
            android:layout_height="70dp"
            android:text="wstecz"
            android:textSize="24dp"
            android:backgroundTint="#cc6600"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/buttonLosuj"
            android:layout_width="138dp"
            android:layout_height="72dp"
            android:text="losuj"
            android:textSize="24dp"
            android:backgroundTint="#99ff00"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/buttonNastepny"
            android:layout_width="138dp"
            android:layout_height="70dp"
            android:text="następny"
            android:textSize="20dp"
            android:backgroundTint="#99ccff"
            android:textColor="@color/black"/>
    </LinearLayout>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:text="tekst"
        android:textSize="50dp"
        />

</LinearLayout>